# Copy to `.env` and fill in. `.env` is gitignored and must never be committed
# (hackathon ground rule 8: credentials stay outside the submission).

ANTHROPIC_API_KEY=sk-ant-...

# Optional per-role model overrides. Format is always `provider:model`, so an
# evaluation run can sweep models without editing code.
#
# Defaults (see config.py):
#   strategist  anthropic:claude-opus-5
#   compiler    anthropic:claude-opus-5
#   tactician   anthropic:claude-haiku-4-5
#   baseline    anthropic:claude-opus-5
#
# AUTOMA_MODEL_TACTICIAN=anthropic:claude-sonnet-5
# AUTOMA_MODEL_STRATEGIST=anthropic:claude-opus-5

# Where trajectories are written. Defaults to ./trajectories
# AUTOMA_TRAJECTORY_DIR=
