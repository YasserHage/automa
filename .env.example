# Copy to `.env` and fill in. `.env` is gitignored and must never be committed
# (hackathon ground rule 8: credentials stay outside the submission).

# Credentials are per provider, one variable each - never a single shared key.
# A match may run two providers at once (Strategist on one, Tactician on another),
# so both can need to be live simultaneously. These names are the ones each vendor
# SDK looks for by default, so they are not ours to rename.

# Required: every role defaults to a Google model (see config.py).
GEMINI_API_KEY=

# Only needed if you point a role back at an Anthropic model.
# ANTHROPIC_API_KEY=sk-ant-...

# Which model each role uses is configuration, not a secret. Format is always
# `provider:model`, so an evaluation run can sweep models without editing code.
#
# Resolution order, most specific first:
#   1. AUTOMA_MODEL_<ROLE>   one role
#   2. AUTOMA_MODEL          every role at once
#   3. DEFAULT_MODELS in config.py, currently google:gemini-3.5-flash-lite
#
# Keep every role on ONE model unless you have a reason not to: Phase 3 compares the
# baseline against the agent, and that comparison only tests the architecture if both
# arms run on the same model.
AUTOMA_MODEL=google:gemini-3.5-flash-lite

# Override a single role, e.g. to give the Compiler a stronger model than the
# per-turn Tactician. A model used here should also have an entry in llm/pricing.py,
# or its cost is reported as `unpriced_model` rather than a number.
# AUTOMA_MODEL_COMPILER=google:gemini-3.6-flash
# AUTOMA_MODEL_TACTICIAN=anthropic:claude-haiku-4-5

# Where trajectories are written. Defaults to ./trajectories
# AUTOMA_TRAJECTORY_DIR=
