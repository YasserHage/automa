# Copy to `.env` and fill in. `.env` is gitignored and must never be committed
# (hackathon ground rule 8: credentials stay outside the submission).

# Credentials are per provider, one variable each - never a single shared key.
# A match may run two providers at once (Strategist on one, Tactician on another),
# so both can need to be live simultaneously. These names are the ones each vendor
# SDK looks for by default, so they are not ours to rename.

# Required: every role defaults to google:gemini-2.5-flash (see config.py).
GEMINI_API_KEY=

# Only needed if you point a role back at an Anthropic model.
# ANTHROPIC_API_KEY=sk-ant-...

# Which model each role uses is configuration, not a secret, and lives per role
# rather than globally. Format is always `provider:model`, so an evaluation run can
# sweep models without editing code.
#
# Defaults (see config.py):
#   strategist  anthropic:claude-opus-5
#   compiler    anthropic:claude-opus-5
#   tactician   anthropic:claude-haiku-4-5
#   baseline    anthropic:claude-opus-5
#
# AUTOMA_MODEL_TACTICIAN=anthropic:claude-sonnet-5
# AUTOMA_MODEL_STRATEGIST=anthropic:claude-opus-5

# Where trajectories are written. Defaults to ./trajectories
# AUTOMA_TRAJECTORY_DIR=
